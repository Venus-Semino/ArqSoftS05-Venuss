	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Citas_App.Application\Citas_App.Application.csproj" />
		<ProjectReference Include="..\Citas_App.Domain\Citas_App.Domain.csproj" />
	</ItemGroup>


</Project>
