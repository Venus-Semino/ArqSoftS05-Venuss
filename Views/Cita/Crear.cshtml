@model CitasApp.Domain.Models.Cita
@{
    ViewData["Title"] = "Agendar Cita Médica";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 card-title fs-5">Agendar Nueva Cita</h2>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Paciente</label>
                        <select asp-for="PacienteId" class="form-select" asp-items="ViewBag.Pacientes" required>
                            <option value="">-- Seleccione el paciente --</option>
                        </select>
                        <span asp-validation-for="PacienteId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Médico Especialista</label>
                        <select asp-for="MedicoId" class="form-select" asp-items="ViewBag.Medicos" required>
                            <option value="">-- Seleccione el médico --</option>
                        </select>
                        <span asp-validation-for="MedicoId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Fecha" class="form-label font-weight-bold">Fecha de la Cita</label>
                        <input asp-for="Fecha" type="date" class="form-control" required />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Hora" class="form-label font-weight-bold">Hora</label>
                        <input asp-for="Hora" type="time" class="form-control" required />
                        <span asp-validation-for="Hora" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Motivo" class="form-label font-weight-bold">Motivo de la Consulta</label>
                    <textarea asp-for="Motivo" class="form-control" rows="3" placeholder="Describa brevemente los síntomas o razón médica..." required></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Estado" class="form-label font-weight-bold">Estado Inicial</label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Pendiente" selected>Pendiente</option>
                        <option value="Confirmada">Confirmada</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4">Agendar Cita</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}