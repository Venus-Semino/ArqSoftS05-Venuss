@model CitaApp.Models.Paciente

@{
    ViewData["Title"] = "Registrar Paciente";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 card-title fs-5">Registrar Nuevo Paciente</h2>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label font-weight-bold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Carlos" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Apellido" class="form-label font-weight-bold">Apellido</label>
                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" required />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="carlos@example.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label font-weight-bold">Teléfono de Contacto</label>
                        <input asp-for="Telefono" class="form-control" placeholder="55-5555-5555" required />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success px-4">Guardar Registro</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}