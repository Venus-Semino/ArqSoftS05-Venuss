@model CitasApp.Domain.Models.Medico
@{
    ViewData["Title"] = "Registrar Médico";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0 card-title fs-5">Registrar Nuevo Médico</h2>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Carlos" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Apellido" class="form-label fw-semibold">Apellido</label>
                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" required />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="medico@hospital.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="55-5555-5555" required />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                </div>

                @if (typeof(CitasApp.Domain.Models.Medico).GetProperty("Especialidad") != null)
                {
                    <div class="mb-3">
                        <label asp-for="Especialidad" class="form-label fw-semibold">Especialidad</label>
                        <input asp-for="Especialidad" class="form-control" placeholder="Ej. Cardiología" />
                        <span asp-validation-for="Especialidad" class="text-danger small"></span>
                    </div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-success px-4">Guardar Médico</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
